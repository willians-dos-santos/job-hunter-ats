# Telegram Bot Credentials (Optional, leave blank for Console-only notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase Credentials
SUPABASE_URL=
SUPABASE_KEY=

# Supabase Search Config (Optional UUID of user in Supabase Auth)
SEARCH_CONFIG_USER_ID=

# Firebase Cloud Messaging (FCM) Credentials
# Option 1 (Priority): Base64-encoded service account JSON (recommended for CI/CD and production environments)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option 2 (Fallback): Path to physical service account JSON credentials file (defaults to ./firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
